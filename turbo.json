{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["vitest.coverage.shared.ts"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:site": {
      "dependsOn": ["^build"],
      "outputs": ["dist/site/**"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "@narrativetrace/core#test": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/documentation/structural-trace-format.md"]
    },
    "@narrativetrace/core#coverage": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/documentation/structural-trace-format.md"]
    },
    "@narrativetrace/tooling#test": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.github/ISSUE_TEMPLATE/narrativetrace-report.yml",
        "$TURBO_ROOT$/packages/skills/**",
        "$TURBO_ROOT$/packages/cli/skills/**"
      ]
    },
    "@narrativetrace/tooling#coverage": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.github/ISSUE_TEMPLATE/narrativetrace-report.yml",
        "$TURBO_ROOT$/packages/skills/**",
        "$TURBO_ROOT$/packages/cli/skills/**"
      ]
    },
    "@narrativetrace/skills-catalogue#test": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.agents/**",
        "$TURBO_ROOT$/.claude/skills/**",
        "$TURBO_ROOT$/.claude-plugin/**",
        "$TURBO_ROOT$/documentation/**"
      ]
    },
    "@narrativetrace/skills-catalogue#coverage": {
      "dependsOn": ["build", "@narrativetrace/example-sixty-seconds#coverage"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.agents/**",
        "$TURBO_ROOT$/.claude/skills/**",
        "$TURBO_ROOT$/.claude-plugin/**",
        "$TURBO_ROOT$/documentation/**"
      ]
    },
    "coverage": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "bench": {
      "dependsOn": ["build"]
    },
    "stress": {
      "dependsOn": ["build"],
      "cache": false,
      "env": [
        "NARRATIVETRACE_STRESS_BUDGET_SECONDS",
        "NARRATIVETRACE_STRESS_LONG",
        "NARRATIVETRACE_STRESS_SEED"
      ]
    },
    "mutate": {
      "dependsOn": ["build"],
      "passThroughEnv": ["NT_MUTATION_WORKERS"]
    }
  }
}
