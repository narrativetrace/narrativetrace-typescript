{
  "name": "@narrativetrace/security-tests",
  "version": "0.1.3",
  "description": "Cross-emitter security and fuzz test suite replaying a shared hostile corpus against every package",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "echo 'security-tests is test-only; nothing to build'",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "fuzz": "tsx tools/run-fuzz.ts"
  },
  "devDependencies": {
    "@jazzer.js/core": "^4.0.0",
    "@narrativetrace/clarity": "workspace:*",
    "@narrativetrace/core": "workspace:*",
    "@narrativetrace/core-node": "workspace:*",
    "@narrativetrace/diagrams": "workspace:*",
    "@narrativetrace/glossary": "workspace:*",
    "@narrativetrace/nestjs": "workspace:*",
    "@narrativetrace/observability": "workspace:*",
    "@narrativetrace/proxy": "workspace:*",
    "@narrativetrace/vitest": "workspace:*",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/testing": "^11.0.0",
    "@types/node": "^22.0.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "yaml": "^2.9.0"
  }
}
