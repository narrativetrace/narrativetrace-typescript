  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narrativetrace/narrativetrace-typescript.git",
    "directory": "packages/nestjs"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "cp ../../LICENSE LICENSE",
    "build": "tsup",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "mutate": "stryker run"
  },
  "peerDependencies": {
    "@narrativetrace/core": "workspace:*",
    "@narrativetrace/core-node": "workspace:*",
    "@narrativetrace/observability": "workspace:*",
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "reflect-metadata": ">=0.1.0",
    "rxjs": ">=7.0.0"
  },
  "devDependencies": {
    "@narrativetrace/core": "workspace:*",
    "@narrativetrace/core-node": "workspace:*",
    "@narrativetrace/observability": "workspace:*",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.15.18",
    "@types/node": "^25.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "unplugin-swc": "^1.5.9"
  }
