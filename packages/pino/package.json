{
  "name": "@narrativetrace/pino",
  "version": "0.1.0",
  "description": "Streams NarrativeTrace method-call events into a Pino logger as structured, per-event log lines",
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narrativetrace/narrativetrace-typescript.git",
    "directory": "packages/pino"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "cp ../../LICENSE LICENSE",
    "build": "tsup",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "mutate": "stryker run"
  },
  "peerDependencies": {
    "@narrativetrace/core": "workspace:*",
    "@narrativetrace/observability": "workspace:*",
    "pino": ">=8.0.0"
  },
  "devDependencies": {
    "@narrativetrace/core": "workspace:*",
    "@narrativetrace/core-node": "workspace:*",
    "@narrativetrace/observability": "workspace:*",
    "pino": "^9.0.0"
  }
}
