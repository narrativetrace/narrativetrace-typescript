{
  "name": "@narrativetrace/proxy",
  "version": "0.1.2",
  "description": "ES Proxy-based tracing: wrap any object to capture its method calls, plus traced/narrated/onError decorators",
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narrativetrace/narrativetrace-typescript.git",
    "directory": "packages/proxy"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "cp ../../LICENSE LICENSE",
    "build": "tsup",
    "test": "vitest run && pnpm run test:dialects",
    "test:dialects": "tsc -p tsconfig.dialect-tc39.json && tsc -p tsconfig.dialect-legacy.json && vitest run --config vitest.legacy.config.ts",
    "coverage": "vitest run --coverage && pnpm run test:dialects",
    "mutate": "stryker run"
  },
  "peerDependencies": {
    "@narrativetrace/core": "workspace:*"
  },
  "devDependencies": {
    "@narrativetrace/core": "workspace:*"
  }
}
