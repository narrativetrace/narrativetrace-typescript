{
  "name": "@narrativetrace/opentelemetry",
  "version": "0.1.1",
  "description": "Bridges NarrativeTrace method-call narratives onto OpenTelemetry spans for existing Jaeger, Tempo, or Datadog views",
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narrativetrace/narrativetrace-typescript.git",
    "directory": "packages/opentelemetry"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "cp ../../LICENSE LICENSE",
    "build": "tsup",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "mutate": "stryker run"
  },
  "peerDependencies": {
    "@narrativetrace/core": "workspace:*",
    "@opentelemetry/api": ">=1.0.0"
  },
  "devDependencies": {
    "@narrativetrace/core": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^1.25.0",
    "@opentelemetry/sdk-trace-node": "^1.25.0"
  }
}
