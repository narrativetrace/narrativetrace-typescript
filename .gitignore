node_modules/
dist/
.turbo/
*.tsbuildinfo
.biome/
coverage/
reports/*
!reports/benchmarks/
# The nightly quality run commits its own report here so the night's result is
# visible in this repo's morning diff; reports/ is stripped from public snapshots.
!reports/nightly/
reports/benchmarks/latest.json
reports/benchmarks/gate-result.json
!reports/parity-review-2026-07-10.md
!reports/parity-review-2026-07-10/
!reports/verification/
**/.stryker-tmp/
**/reports/mutation/
stryker.log

# Security-tooling self-installs (gitleaks/osv-scanner/semgrep venv) — downloaded
# on demand by scripts/gitleaks.sh, scripts/osv-scan.sh, scripts/semgrep-scan.sh;
# never checked in.
.tools-cache/

# verify:all's per-category raw command logs (tools/verify-all.ts) — the summary lives in
# reports/verification/<date>.md; this is where the full output goes when a row isn't a clean
# pass, mirroring the Java golden repo's gitignored build/verifyAll-logs/.
.verify-all-logs/

.pnpm-store/


# Session hardening progress notes (untracked working records)
.hardening-progress-*.md


# git-secret: the revealed plaintext must never be committed; the encrypted
# .secret files and everything else under .gitsecret are meant to be tracked.
.gitsecret/keys/random_seed
!*.secret
secret.properties


# prepack copies the root LICENSE into the package for the npm tarball;
# the working-tree copy is a pack artifact, never committed.
packages/*/LICENSE
